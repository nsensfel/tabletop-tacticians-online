findFirstIndex: (a -> Bool) -> (Array a) -> Int
findFirstIndex cond array =
   (Array.indexedFoldl
      (\ix val current ->
         if ((current == -1) && (cond val))
         then ix
         else current
      )
      -1
      array
   )

findLastIndex: (a -> Bool) -> (Array a) -> Int
findLastIndex cond array =
   (Array.indexedFoldl
      (\ix val current ->
         if (cond val)
         then ix
         else current
      )
      -1
      array
   )
