update :
   (
      String ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
update token model =
   {
      model = (Struct.Model.set_session_token tokenpage model),
      command = Cmd.none
   }
