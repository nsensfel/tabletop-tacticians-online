module Update.RoomPage exposing (update)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Error
import Struct.Event
import Struct.Model

import Struct.Page
import Struct.Page.Room

import Update.RoomPage.CancelSelection

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
update :
   (
      Struct.Page.Room.Event ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
update room_page_event model =
   when (Struct.Model.get_page model) is
      (Struct.Page.Room room) ->
         when room_page_event is
            Struct.Page.Room.CancelSelection ->
               (Update.RoomPage.CancelSelection.update room model)

            _ ->
               {
                  model =
                     (Struct.Model.push_error
                        Struct.Error.Programming
                        (
                           "Cannot handle unimplemented Room Page Event \""
                           ++
                           (Struct.Page.Room.event_to_string
                              room_page_event
                           )
                           ++ "\" ."
                        )
                        model
                     ),
                  command = Cmd.none
               }
      _ ->
         {
            model =
               (Struct.Model.push_error
                  Struct.Error.Programming
                  (
                     "Cannot handle Room Page Event \""
                     ++ (Struct.Page.Room.event_to_string room_page_event)
                     ++ "\" outside of Room Page."
                  )
                  model
               ),
            command = Cmd.none
         }
