module Update.SetPage exposing (update)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Event
import Struct.Model
import Struct.Page

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------
generate_url_parameters_update : Struct.Page.Type -> (Cmd Struct.Event.Type)
generate_url_parameters_update page =
   -- Nope. Should update model's stored URL args then set invocation params
   -- as dirty.
   (Struct.Event.Sequence
      (
         (Struct.Event.ClearUrlParams)
         ::
         (
            when page is
               Home -> [(Struct.Event.SetUrlParam "page" "")]
               | (RoomList _) -> [(Struct.Event.SetUrlParam "page" "room_list")]
               | (Login _) -> [(Struct.Event.SetUrlParam "page" "login")]

               | (EditProfile _) ->
                  [(Struct.Event.SetUrlParam "page" "edit_profile")]

               | (Room room) ->
                  [
                     (Struct.Event.SetUrlParam "page" "room"),
                     (Struct.Event.SetUrlParam "id" (Struct.Room.get_id room))
                  ]

               | (CreateRoom _) ->
                  [(Struct.Event.SetUrlParam "page" "create_room")]

               | (Register _) ->
                  [(Struct.Event.SetUrlParam "page" "register")]

               | (Unknown name) ->
                  [(Struct.Event.SetUrlParam "page" "name")]
         )
      )
   )
--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
update :
   (
      Struct.Page.Type ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
update page model =
   {
      model = (Struct.Model.set_page page model),
      command = (generate_url_parameters_update page)
   }
