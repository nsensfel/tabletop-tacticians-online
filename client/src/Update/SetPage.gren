module Update.SetPage exposing (update)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Event
import Struct.InvocationParameters
import Struct.Model
import Struct.Page

import Struct.Page.Room

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
update :
   (
      Struct.Page.Type ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
update page model =
   let
      reset_invocation_parameters =
         (Struct.InvocationParameters.erase_url_parameters
            (Struct.Model.get_invocation_parameters model)
         )
      new_model = (Struct.Model.set_page page model)
   in
      when page is
         Struct.Page.Home ->
            {
               command = (Cmd.none),
               model =
                  (Struct.Model.set_invocation_parameters
                     reset_invocation_parameters
                     new_model
                  )
            }

         (Struct.Page.Loading _) ->
            {
               command = (Cmd.none),
               model = new_model
            }

         (Struct.Page.RoomList _) ->
            {
               command = (Cmd.none),
               model =
                  (Struct.Model.set_invocation_parameters
                     (Struct.InvocationParameters.set_url_parameter
                        "page"
                        "room_list"
                        reset_invocation_parameters
                     )
                     new_model
                  )
            }

         (Struct.Page.Login _) ->
            {
               command = (Cmd.none),
               model =
                  (Struct.Model.set_invocation_parameters
                     (Struct.InvocationParameters.set_url_parameter
                        "page"
                        "login"
                        reset_invocation_parameters
                     )
                     new_model
                  )
            }

         (Struct.Page.EditProfile _) ->
            {
               command = (Cmd.none),
               model =
                  (Struct.Model.set_invocation_parameters
                     (Struct.InvocationParameters.set_url_parameter
                        "page"
                        "edit_profile"
                        reset_invocation_parameters
                     )
                     new_model
                  )
            }

         (Struct.Page.Room room) ->
            let
               updated_model =
                  (Struct.Model.set_invocation_parameters
                     (Struct.InvocationParameters.set_url_parameter
                        "page"
                        "room"
                        (Struct.InvocationParameters.set_url_parameter
                           "id"
                           (Struct.Page.Room.get_id room)
                           reset_invocation_parameters
                        )
                     )
                     new_model
                  )
            in
               {
                  command = Cmd.none, -- May need to start Puppeteer.
                  model = updated_model
               }

         (Struct.Page.CreateRoom _) ->
            {
               command = (Cmd.none),
               model =
                  (Struct.Model.set_invocation_parameters
                     (Struct.InvocationParameters.set_url_parameter
                        "page"
                        "create_room"
                        reset_invocation_parameters
                     )
                     new_model
                  )
            }

         (Struct.Page.Register _) ->
            {
               command = (Cmd.none),
               model =
                  (Struct.Model.set_invocation_parameters
                     (Struct.InvocationParameters.set_url_parameter
                        "page"
                        "register"
                        reset_invocation_parameters
                     )
                     new_model
                  )
            }

         (Struct.Page.Unknown name) ->
            {
               command = (Cmd.none),
               model =
                  (Struct.Model.set_invocation_parameters
                     (Struct.InvocationParameters.set_url_parameter
                        "page"
                        name
                        reset_invocation_parameters
                     )
                     new_model
                  )
            }
