module Update.RoomListPage exposing (update)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Error
import Struct.Event
import Struct.Model

import Struct.Page
import Struct.Page.RoomList

import Update.RoomListPage.EnterRoom

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
update :
   (
      Struct.Page.RoomList.Event ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
update room_list_page_event model =
   when (Struct.Model.get_page model) is
      (Struct.Page.RoomList room_list) ->
         when room_list_page_event is
            (Struct.Page.RoomList.EnterRoom val) ->
               (Update.RoomListPage.EnterRoom.update val room_list model)

            _ ->
               {
                  model =
                     (Struct.Model.push_error
                        Struct.Error.Programming
                        (
                           "Cannot handle unimplemented RoomList Page Event \""
                           ++
                           (Struct.Page.RoomList.event_to_string
                              room_list_page_event
                           )
                           ++ "\" ."
                        )
                        model
                     ),
                  command = Cmd.none
               }
      _ ->
         {
            model =
               (Struct.Model.push_error
                  Struct.Error.Programming
                  (
                     "Cannot handle RoomList Page Event \""
                     ++ (Struct.Page.RoomList.event_to_string room_list_page_event)
                     ++ "\" outside of RoomList Page."
                  )
                  model
               ),
            command = Cmd.none
         }
