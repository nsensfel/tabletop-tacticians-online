module Update.RoomListPage.EnterRoom exposing (update)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Error
import Struct.Event
import Struct.Model
import Struct.Session

import Struct.Page
import Struct.Page.RoomList
import Struct.Page.Loading

import Comm.Send

import Update.Error

import Dragoman.RoomLoadQuery

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
update :
   (
      String ->
      Struct.Page.RoomList.Type ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
update room_id room_list model =
   when
      (Struct.Session.maybe_get_credentials
         (Struct.Model.get_session model)
      )
   is
      (Just credentials) ->
         {
            command =
               (Comm.Send.send
                  (Dragoman.RoomLoadQuery.encode
                     (Dragoman.RoomLoadQuery.new
                        credentials
                        room_id
                     )
                  )
                  Comm.Send.RoomHandler
               ),
            model =
               (Struct.Model.set_page
                  (Struct.Page.Loading (Struct.Page.Loading.new))
                  model
               )
         }

      Nothing ->
         (Update.Error.update
            (Struct.Error.new
               Struct.Error.Error
               "Not logged in -> Cannot load a room."
            )
            model
         )
