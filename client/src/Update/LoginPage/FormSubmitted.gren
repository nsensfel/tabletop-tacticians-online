module Update.LoginPage.FormSubmitted exposing (update)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Error
import Struct.Event
import Struct.Model

import Struct.Page.Login

import Comm.Send

import Util.DetectMissingField

import Dragoman.LoginQuery

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
update :
   (
      Struct.Page.Login.Type ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
update login model =
   let query = (Struct.Page.Login.get_query login) in
      when
         (Util.DetectMissingField.apply
            [
               (Dragoman.LoginQuery.get_username query),
               (Dragoman.LoginQuery.get_password query)
            ]
            [
               "username",
               "password"
            ]
         )
      is
         (Just name) ->
            {
               model =
                  (Struct.Model.push_error
                     Struct.Error.Error
                     ("Missing " ++ name)
                     model
                  ),
               command = Cmd.none
            }

         Nothing ->
            {
               model = model, -- TODO: acknowledge it's been sent?
               command =
                  (Comm.Send.send
                     (Dragoman.LoginQuery.encode query)
                     (Comm.Send.LoginHandler)
                  )
            }
