module Update.EditProfilePage.FormSubmitted exposing (update)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Dragoman.EditProfileQuery

import Struct.Error
import Struct.Event
import Struct.Model

import Struct.Page.EditProfile

import Comm.Send

import Util.DetectMissingField

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
update :
   (
      Struct.Page.EditProfile.Type ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
update edit model =
   let query = (Struct.Page.EditProfile.get_query edit) in
      when
         (Util.DetectMissingField.apply
            [
               (Dragoman.EditProfileQuery.get_password query)
            ]
            [
               "password"
            ]
         )
      is
         (Just name) ->
            {
               model =
                  (Struct.Model.push_error
                     Struct.Error.MissingInput
                     ("Missing " ++ name)
                     model
                  ),
               command = Cmd.none
            }

         Nothing ->
            if
            (
               (Dragoman.EditProfileQuery.get_new_password query)
               == (Struct.Page.EditProfile.get_new_password_confirmation edit)
            )
            then
               {
                  model = model,
                  command =
                     (Comm.Send.send
                        (Dragoman.EditProfileQuery.encode query)
                        Comm.Send.EditProfileHandler
                     )
               }
            else
               {
                  model =
                     (Struct.Model.push_error
                        Struct.Error.Error
                        ("New Password and New Password Confirmation mismatch")
                        model
                     ),
                  command = Cmd.none
               }
