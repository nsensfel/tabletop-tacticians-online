update :
   (
      Struct.Page.EditProfile.Type ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
update edit_profile model =
   (Comm.Send.EditProfileRequest.send edit_profile model)
