module Update.RegisterPage.FormSubmitted exposing (update)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Error
import Struct.Event
import Struct.Model

import Struct.Page.Register

import Comm.Send.RegisterRequest

import Util.DetectMissingField

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
update :
   (
      Struct.Page.Register.Type ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
update login model =
   when
      (Util.DetectMissingField
         [
            (Struct.Page.Register.get_username login),
            (Struct.Page.Register.get_password login),
            (Struct.Page.Register.get_displayed_name login),
            (Struct.Page.Register.get_email login),
            (Struct.Page.Register.get_password_confirmation login),
         ]
         [
            "username",
            "password",
            "displayed name",
            "email",
            "password confirmation"
         ]
      )
   is
      (Just name) ->
         {
            model =
               (Struct.Model.push_error
                  Struct.Error.MissingInput
                  ("Missing " ++ name)
                  model
               ),
            command = Cmd.none
         }

      Nothing ->
         if
         (
            (Struct.Page.Register.get_password login)
            == (Struct.Page.Register.get_password_confirmation login)
         )
         then (Comm.Send.RegisterRequest.send login model)
         else
         {
            model =
               (Struct.Model.push_error
                  Struct.Error.Error
                  ("Password and Password Confirmation mismatch")
                  model
               ),
            command = Cmd.none
         }
