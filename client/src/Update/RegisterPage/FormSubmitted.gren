module Update.RegisterPage.FormSubmitted exposing (update)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Error
import Struct.Event
import Struct.Model

import Struct.Page.Register

import Comm.Send

import Util.DetectMissingField

import Dragoman.RegisterQuery

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
update :
   (
      Struct.Page.Register.Type ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
update register model =
   let query = (Struct.Page.Register.get_query register) in
      when
         (Util.DetectMissingField.apply
            [
               (Dragoman.RegisterQuery.get_username query),
               (Dragoman.RegisterQuery.get_password query),
               (Dragoman.RegisterQuery.get_displayed_name query),
               (Dragoman.RegisterQuery.get_email query),
               (Dragoman.RegisterQuery.get_avatar query),
               (Struct.Page.Register.get_password_confirmation register)
            ]
            [
               "username",
               "password",
               "displayed name",
               "email",
               "avatar",
               "password confirmation"
            ]
         )
      is
         (Just name) ->
            {
               model =
                  (Struct.Model.push_error
                     Struct.Error.MissingInput
                     ("Missing " ++ name)
                     model
                  ),
               command = Cmd.none
            }

         Nothing ->
            if
            (
               (Dragoman.RegisterQuery.get_password query)
               == (Struct.Page.Register.get_password_confirmation register)
            )
            then
               {
                  model = model,
                  command =
                     (Comm.Send.send
                        (Dragoman.RegisterQuery.encode query)
                        Comm.Send.RegisterHandler
                     )
               }
            else
               {
                  model =
                     (Struct.Model.push_error
                        Struct.Error.Error
                        ("Password and Password Confirmation mismatch")
                        model
                     ),
                  command = Cmd.none
               }
