module Update.Login exposing (update)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Event
import Struct.Model

import Struct.Page
import Struct.Page.Login

import Update.Login.FormSubmitted
import Update.Login.SetPasswordTo
import Update.Login.SetUsernameTo

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
update :
   (
      Struct.Page.Login.Event ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
update login_page_event model =
   when (Struct.Model.get_page model) is
      (Struct.Page.Login login) ->
         when login_page_event is
            Struct.Page.Login.FormSubmitted ->
               (Update.Login.FormSubmitted.update login model)

            (Struct.Page.Login.SetPasswordTo val) ->
               (Update.Login.SetPasswordTo.update val login model)

            (Struct.Page.Login.SetUsernameTo val) ->
               (Update.Login.SetUsernameTo.update val login model)

            _ ->
               {
                  model =
                     (Struct.Model.push_error
                        (Struct.Error.new
                           Struct.Error.Programming
                           (
                              "Cannot handle unimplemented Login Page Event \""
                              ++
                              (Struct.Page.Login.event_to_string
                                 login_page_event
                              )
                              ++ "\" ."
                           )
                        )
                     ),
                  command = Cmd.none
               }
      _ ->
         {
            model =
               (Struct.Model.push_error
                  (Struct.Error.new
                     Struct.Error.Programming
                     (
                        "Cannot handle Login Page Event \""
                        ++ (Struct.Page.Login.event_to_string login_page_event)
                        ++ "\" outside of Login Page."
                     )
                  )
               ),
            command = Cmd.none
         }
