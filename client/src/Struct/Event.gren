module Struct.Event exposing (Type(..), to_string)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Browser

import Url

-- Third Party -----------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Error
import Struct.KeyValue
import Struct.Page
import Struct.Session

import Dragoman.ServerReply

import Struct.Page.EditProfile
import Struct.Page.Room
import Struct.Page.RoomList
import Struct.Page.Login
import Struct.Page.Register

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------
type Type =
   None
   | ClearUrlParams
   | Confirm
   | EditProfilePage Struct.Page.EditProfile.Event
   | EraseLocalValue String
   | EraseUrlParam String
   | ErrorOccurred Struct.Error.Type
   | LoginPage Struct.Page.Login.Event
   | RegisterPage Struct.Page.Register.Event
   | RoomListPage Struct.Page.RoomList.Event
   | RoomPage Struct.Page.Room.Event
   | Sequence (Array Type)
   | SetLocalValue Struct.KeyValue.Type
   | SetPage Struct.Page.Type
   | SetSession Struct.Session.Type
   | SetUrlParam Struct.KeyValue.Type
   | UnknownMessageTypeReceived String
   | ServerReplied Dragoman.ServerReply.Type

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
to_string : Type -> String
to_string event =
   when event is
      None -> "None"
      (Sequence seq) -> ("(Sequence: " ++ "..." ++ ")")
      (LoginPage login_event) ->
         (
            "(Login Event: "
            ++ (Struct.Page.Login.event_to_string login_event)
            ++ ")"
         )

      (RegisterPage register_event) ->
         (
            "(Register Event: "
            ++ (Struct.Page.Register.event_to_string register_event)
            ++ ")"
         )

      (EditProfilePage edit_profile_event) ->
         (
            "(EditProfile Event: "
            ++ (Struct.Page.EditProfile.event_to_string edit_profile_event)
            ++ ")"
         )

      (RoomListPage room_list_event) ->
         (
            "(RoomList Event: "
            ++ (Struct.Page.RoomList.event_to_string room_list_event)
            ++ ")"
         )

      (RoomPage room_event) ->
         (
            "(Room Event: "
            ++ (Struct.Page.Room.event_to_string room_event)
            ++ ")"
         )

      (SetLocalValue _) -> "SetLocalValue"
      (EraseLocalValue _) -> "EraseLocalValue"
      (SetUrlParam _) -> "SetUrlParam"
      (SetSession _) -> "SetSession"
      (SetPage _) -> "SetPage"
      ClearUrlParams -> "ClearUrlParams"
      (EraseUrlParam _) -> "EraseUrlParam"
      (ServerReplied _) -> "ServerReplied"

      (UnknownMessageTypeReceived str) ->
         ("UnknownMessageTypeReceived: " ++ str)

      (ErrorOccurred _) -> "ErrorOccurred"
      Confirm -> "Confirm"
