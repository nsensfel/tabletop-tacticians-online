module Struct.Session exposing
   (
      Type,
      none,

      maybe_get_credentials,
      set_credentials,
      clear_credentials,

      get_pending_rooms,
      set_pending_rooms
   )

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------

-- Third Party -----------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Dragoman.Credentials

import Struct.Session.PendingRoom

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------
type alias Type =
   {
      credentials: (Maybe Dragoman.Credentials.Type),
      pending_rooms: (Array Struct.Session.PendingRoom.Type)
   }

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
none: Type
none =
   {
      credentials = Nothing,
      pending_rooms = []
   }

set_credentials: Dragoman.Credentials.Type -> Type -> Type
set_credentials credentials session =
   {session | credentials = (Just credentials)}

maybe_get_credentials: Type -> (Maybe Dragoman.Credentials.Type)
maybe_get_credentials session = session.credentials

clear_credentials: Type -> Type
clear_credentials session = {session | credentials = Nothing}

get_pending_rooms: Type -> (Array Struct.Session.PendingRoom.Type)
get_pending_rooms session = session.pending_rooms

set_pending_rooms: (Array Struct.Session.PendingRoom.Type) -> Type -> Type
set_pending_rooms rooms session = {session | pending_rooms = rooms}
