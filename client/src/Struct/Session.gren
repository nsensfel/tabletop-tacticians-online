module Struct.Session exposing
   (
      Type,
      none,

      get_credentials,
      set_credentials,

      get_pending_rooms,
      set_pending_rooms
   )

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------

-- Third Party -----------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Dragoman.ServerReply
import Dragoman.ServerReplyID
import Dragoman.SetSessionReply

import Struct.Session.PendingRoom

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------
type alias Type =
   {
      credentials: Dragoman.SetSessionReply.Type,
      pending_rooms: (Array Struct.Session.PendingRoom.Type)
   }

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
none: Type
none =
   {
      credentials =
         (Dragoman.SetSessionReply.new
            -1
            ""
            ""
            Dragoman.ServerReplyID.SET_SESSION
         ),
      pending_rooms = []
   }

set_credentials: Dragoman.SetSessionReply.Type -> Type -> Type
set_credentials credentials session = {session | credentials = credentials}

get_credentials: Type -> Dragoman.SetSessionReply.Type
get_credentials session = session.credentials

get_pending_rooms: Type -> (Array Struct.Session.PendingRoom.Type)
get_pending_rooms session = session.pending_rooms

set_pending_rooms: (Array Struct.Session.PendingRoom.Type) -> Type -> Type
set_pending_rooms rooms session = {session | pending_rooms = rooms}
