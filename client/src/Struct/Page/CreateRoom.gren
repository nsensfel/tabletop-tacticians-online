module Struct.Page.CreateRoom exposing
   (
      Type,
      Event(..),
      new,
      get_name,
      set_name,
      get_selected_room,
      set_selected_room,
      get_available_rooms,
      set_available_rooms,
      event_to_string
   )

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Dict

-- Third Party -----------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Page.CreateRoom.Room

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------
type alias Type =
   {
      name : String,
      selected_room : String,
      available_rooms : (Dict.Dict String Struct.Page.CreateRoom.Room.Type)
   }

type Event =
   FormSubmitted
   | SetNameTo String
   | SetSelectedRoomTo String

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
event_to_string : Event -> String
event_to_string event =
   when event is
      FormSubmitted -> "FormSubmitted"
      (SetNameTo _) -> "SetNameTo"
      (SetSelectedRoomTo _) -> "SetSelectedRoomTo"

new : Type
new =
   {
      name = "",
      selected_room = "",
      available_rooms = (Dict.empty)
   }

get_name : Type -> String
get_name create_room = create_room.name

set_name : String -> Type -> Type
set_name name create_room = {create_room | name = name}

get_selected_room : Type -> String
get_selected_room create_room = create_room.selected_room

set_selected_room : String -> Type -> Type
set_selected_room selected_room create_room =
   {create_room | selected_room = selected_room}

get_available_rooms :
   (
      Type ->
      (Dict.Dict String Struct.Page.CreateRoom.Room.Type)
   )
get_available_rooms create_room = create_room.available_rooms

set_available_rooms :
   (
      (Dict.Dict String Struct.Page.CreateRoom.Room.Type) ->
      Type ->
      Type
   )
set_available_rooms available_rooms create_room =
   {create_room | available_rooms = available_rooms}
