module Struct.Page.CreateGame exposing
   (
      Type,
      Event(..),
      new,
      get_name,
      set_name,
      get_selected_game,
      set_selected_game,
      get_available_games,
      set_available_games,
      event_to_string
   )

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Dict

-- Third Party -----------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Page.CreateGame.Game

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------
type alias Type =
   {
      name : String,
      selected_game : String,
      available_games : (Dict.Dict String Struct.Page.CreateGame.Game.Type)
   }

type Event =
   FormSubmitted
   | SetNameTo String
   | SetSelectedGameTo String

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
event_to_string : Event -> String
event_to_string event =
   when event is
      FormSubmitted -> "FormSubmitted"
      (SetNameTo _) -> "SetNameTo"
      (SetSelectedGameTo _) -> "SetSelectedGameTo"

new : Type
new =
   {
      name = "",
      selected_game = "",
      available_games = (Dict.empty)
   }

get_name : Type -> String
get_name create_game = create_game.name

set_name : String -> Type -> Type
set_name name create_game = {create_game | name = name}

get_selected_game : Type -> String
get_selected_game create_game = create_game.selected_game

set_selected_game : String -> Type -> Type
set_selected_game selected_game create_game =
   {create_game | selected_game = selected_game}

get_available_games :
   (
      Type ->
      (Dict.Dict String Struct.Page.CreateGame.Game.Type)
   )
get_available_games create_game = create_game.available_games

set_available_games :
   (
      (Dict.Dict String Struct.Page.CreateGame.Game.Type) ->
      Type ->
      Type
   )
set_available_games available_games create_game =
   {create_game | available_games = available_games}
