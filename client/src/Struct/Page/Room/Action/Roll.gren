module Struct.Page.Room.Action.Roll exposing
   (
      Type,
      get_object_ids,
      get_previous_faces,
      get_new_faces,
      decoder
   )

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Json.Decode

-- Third Party -----------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Comm.Protocol

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------
type alias Type =
   {
      object_ids : (Array String),
      previous_faces : (Array Int),
      new_faces : (Array Int)
   }

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
get_object_ids : (Array String)
get_object_ids roll = roll.object_ids

get_previous_faces : (Array Int)
get_previous_faces roll = roll.previous_faces

get_new_faces : (Array Int)
get_new_faces roll = roll.new_faces

decoder : (Json.Decode.Decoder Type)
decoder =
   (Json.Decode.map3
      ( \object_ids previous_faces new_faces ->
      )
      (Json.Decode.field
         Comm.Protocol.object_ids_field
         (Json.Decode.array Json.Decode.string)
      )
      (Json.Decode.field
         Comm.Protocol.previous_faces_field
         (Json.Decode.array Json.Decode.int)
      )
      (Json.Decode.field
         Comm.Protocol.new_faces_field
         (Json.Decode.array Json.Decode.int)
      )
   )
