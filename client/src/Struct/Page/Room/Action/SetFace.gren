module Struct.Page.Room.Action.SetFace exposing
   (
      Type,
      get_object_ids,
      get_previous_faces,
      get_new_face,
      decoder
   )

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Json.Decode

-- Third Party -----------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Comm.Protocol

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------
type alias Type =
   {
      object_ids : (Array String),
      previous_faces : (Array Int),
      new_face : Int
   }

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
get_new_face : Type -> Int
get_new_face set_face = set_face.new_face

get_object_ids : Type -> (Array String)
get_object_ids set_face = set_face.object_ids

get_previous_faces : Type -> (Array Int)
get_previous_faces set_face = set_face.previous_faces

decoder : (Json.Decode.Decoder Type)
decoder =
   (Json.Decode.map3
      ( \object_ids previous_faces new_face ->
         {
            object_ids = object_ids,
            previous_faces = previous_faces,
            new_face = new_face
         }
      )
      (Json.Decode.field
         Comm.Protocol.object_ids_field
         (Json.Decode.array Json.Decode.string)
      )
      (Json.Decode.field
         Comm.Protocol.previous_faces_field
         (Json.Decode.array Json.Decode.int)
      )
      (Json.Decode.field Comm.Protocol.new_face_field Json.Decode.int)
   )
