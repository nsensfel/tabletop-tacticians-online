module Struct.Page.Room.Selection exposing
   (
      Type,
      new,
      toggle_deck,
      toggle_card,
      toggle_die,
      clear,
      get_decks,
      get_cards,
      get_dice,
      get_is_active
   )

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Set

-- Third Party -----------------------------------------------------------------

-- Project ---------------------------------------------------------------------

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------
type alias Type =
   {
      decks : (Set.Set String),
      cards : (Set.Set String),
      dice : (Set.Set String)
   }

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
new : Type
new =
   {
      decks = (Set.empty),
      cards = (Set.empty),
      dice = (Set.empty)
   }

toggle_deck : String -> Type -> Type
toggle_deck deck_id selection =
   {selection | decks = (Set.toggle deck_id selection.decks)}

toggle_card : String -> Type -> Type
toggle_card card_id selection =
   {selection | cards = (Set.toggle card_id selection.cards)}

toggle_die : String -> Type -> Type
toggle_die die_id selection =
   {selection | dice = (Set.toggle die_id selection.dice)}

clear : Type -> Type
clear _selection = (new)

get_decks: Type -> (Set.Set String)
get_decks selection = selection.decks

get_cards: Type -> (Set.Set String)
get_cards selection = selection.cards

get_dice: Type -> (Set.Set String)
get_dice selection = selection.dice

get_is_active : Type -> Bool
get_is_active selection =
   (not
      (
         (Set.isEmpty selection.decks)
         && (Set.isEmpty selection.cards)
         &&(Set.isEmpty selection.dice)
      )
   )
