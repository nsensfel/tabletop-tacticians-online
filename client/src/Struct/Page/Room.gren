module Struct.Page.Room exposing
   (
      Type,
      Event(..),
      new,
      get_id,
      get_players,
      set_players,
      get_objects,
      set_objects,
      get_puppeteer,
      set_puppeteer,
      event_to_string
   )

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Dict

-- Third Party -----------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Dragoman.Room
import Dragoman.RoomAction
import Dragoman.RoomObject

import Struct.Page.Room.Action
import Struct.Page.Room.Chat
import Struct.Page.Room.DeckBrowser
import Struct.Page.Room.Player
import Struct.Page.Room.Puppeteer
import Struct.Page.Room.Selection

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------
type alias Type =
   {
      id: String,
      name: String,
      game_id: String,
      objects: (Dict.Dict String Dragoman.RoomObject.Type),
      history: (Array Dragoman.RoomAction.Type),
      history_index: Int,
      players: (Dict.Dict String Struct.Page.Room.Player.Type),
      chat: Struct.Page.Room.Chat.Type,
      selection: Struct.Page.Room.Selection.Type,
      deck_browser: Struct.Page.Room.DeckBrowser.Type,
      puppeteer: Struct.Page.Room.Puppeteer.Type
   }

-- Events here are how the user interact with the client. Not the puppeteer's
-- actions.
type Event =
   SelectCard String
   | SelectDeck String
   | CancelSelection
   | Rotate
   | Flip
   | Peek
   | ToggleLock
   | SendTo String
   | Shuffle
   | Regroup
   | Pop
   | PopTop
   | PopBottom
   | PeekN Int
   | Ping
   | PingPlayer String
   | SendAllTo String
   | SendTopTo String
   | SendBottomTo String
   | Browse
   | BrowseN Int
   -- Missing: move cards around in deck.
   | ZIndexMin
   | ZIndexLess
   | ZIndexMore
   | ZIndexMax
   | SendChatMessage

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
event_to_string: Event -> String
event_to_string event =
   when event is
      (SelectCard _) -> "SelectCard"
      (SelectDeck _) -> "SelectDeck"
      CancelSelection -> "CancelSelection"
      Rotate -> "Rotate"
      _ -> "other"

new: Dragoman.Room.Type -> Type
new drago_room =
   {
      id = (Dragoman.Room.get_id drago_room),
      name = (Dragoman.Room.get_name drago_room),
      game_id = (Dragoman.Room.get_game_id drago_room),
      objects = (Dragoman.Room.get_objects drago_room),
      history = (Dragoman.Room.get_history drago_room),
      history_index = (Dragoman.Room.get_history_index drago_room),
      players = (Dict.empty),
      chat = (Struct.Page.Room.Chat.new),
      selection = (Struct.Page.Room.Selection.new),
      deck_browser = (Struct.Page.Room.DeckBrowser.new),
      puppeteer = (Struct.Page.Room.Puppeteer.new [])
   }

get_id: Type -> String
get_id room = room.id

get_objects: Type -> (Dict.Dict String Dragoman.RoomObject.Type)
get_objects room = room.objects

set_objects: (Dict.Dict String Dragoman.RoomObject.Type) -> Type -> Type
set_objects objects room = {room | objects = objects}

get_players: Type -> (Dict.Dict String Struct.Page.Room.Player.Type)
get_players room = room.players

set_players: (Dict.Dict String Struct.Page.Room.Player.Type) -> Type -> Type
set_players players room = {room | players = players}

get_name: Type -> String
get_name room = room.name

get_chat: Type -> Struct.Page.Room.Chat.Type
get_chat room = room.chat

set_chat: Struct.Page.Room.Chat.Type -> Type -> Type
set_chat chat room = {room | chat = chat}

get_puppeteer: Type -> Struct.Page.Room.Puppeteer.Type
get_puppeteer room = room.puppeteer

set_puppeteer: Struct.Page.Room.Puppeteer.Type -> Type -> Type
set_puppeteer puppeteer room = {room | puppeteer = puppeteer}

get_selection: Type -> Struct.Page.Room.Selection.Type
get_selection room = room.selection

get_deck_browser: Type -> Struct.Page.Room.DeckBrowser.Type
get_deck_browser room = room.deck_browser

set_name: String -> Type -> Type
set_name name room = {room | name = name}

set_selection: Struct.Page.Room.Selection.Type -> Type -> Type
set_selection selection room = {room | selection = selection}

set_deck_browser: Struct.Page.Room.DeckBrowser.Type -> Type -> Type
set_deck_browser deck_browser room = {room | deck_browser = deck_browser}
