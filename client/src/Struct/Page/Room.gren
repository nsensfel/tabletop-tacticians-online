module Struct.Page.Room exposing
   (
      Type,
      Event(..),
      new,
      get_decks,
      set_decks,
      get_players,
      set_players,
      get_cards,
      set_cards,
      event_to_string,
      decoder
   )

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Dict

-- Third Party -----------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Page.Room.Card
import Struct.Page.Room.Deck
import Struct.Page.Room.Player
import Struct.Page.Room.Chat
import Struct.Page.Room.Selection
import Struct.Page.Room.DeckBrowser

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------
type alias Type =
   {
      id : String,
      name : String,
      players : (Dict.Dict String Struct.Page.Room.Player.Type),
      decks : (Dict.Dict String Struct.Page.Room.Deck.Type),
      cards : (Dict.Dict String Struct.Page.Room.Card.Type),
      chat : Struct.Page.Room.Chat.Type,
      selection : Struct.Page.Room.Selection.Type,
      deck_browser : Struct.Page.Room.DeckBrowser.Type
   }

-- Events here are how the user interact with the client. Not the puppeteer's
-- actions.
type Event =
   SelectCard String
   | SelectDeck String
   | CancelSelection
   | Rotate
   | Flip
   | Peek
   | ToggleLock
   | SendTo String
   | Shuffle
   | Regroup
   | Pop
   | PopTop
   | PopBottom
   | PeekN Int
   | Ping
   | PingPlayer String
   | SendAllTo String
   | SendTopTo String
   | SendBottomTo String
   | Browse
   | BrowseN Int
   -- Missing: move cards around in deck.
   | ZIndexMin
   | ZIndexLess
   | ZIndexMore
   | ZIndexMax
   | SendChatMessage

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
event_to_string : Event -> String
event_to_string event =
   when event is
      (SelectCard _) -> "SelectCard"
      (SelectDeck _) -> "SelectDeck"
      CancelSelection -> "CancelSelection"
      Rotate -> "Rotate"
      _ -> "other"

new : Type
new =
   {
      id = "",
      name = "",
      players = (Dict.empty),
      decks = (Dict.empty),
      cards = (Dict.empty),
      chat = (Struct.Page.Room.Chat.new),
      selection = (Struct.Page.Room.Selection.new),
      deck_browser = (Struct.Page.Room.DeckBrowser.new)
   }

get_decks : Type -> (Dict.Dict String Struct.Page.Room.Deck.Type)
get_decks room = room.decks

set_decks : (Dict.Dict String Struct.Page.Room.Deck.Type) -> Type -> Type
set_decks decks room = {room | decks = decks}

get_players : Type -> (Dict.Dict String Struct.Page.Room.Player.Type)
get_players room = room.players

set_players : (Dict.Dict String Struct.Page.Room.Player.Type) -> Type -> Type
set_players players room = {room | players = players}

get_cards : Type -> (Dict.Dict String Struct.Page.Room.Card.Type)
get_cards room = room.cards

set_cards : (Dict.Dict String Struct.Page.Room.Card.Type) -> Type -> Type
set_cards cards room = {room | cards = cards}

get_name : Type -> String
get_name room = room.name

get_chat : Type -> Struct.Page.Room.Chat.Type
get_chat room = room.chat

get_selection : Type -> Struct.Page.Room.Selection.Type
get_selection room = room.selection

get_deck_browser : Type -> Struct.Page.Room.DeckBrowser.Type
get_deck_browser room = room.deck_browser

set_name : String -> Type -> Type
set_name name room = {room | name = name}

set_chat : Struct.Page.Room.Chat.Type -> Type -> Type
set_chat chat room = {room | chat = chat}

set_selection : Struct.Page.Room.Selection.Type -> Type -> Type
set_selection selection room = {room | selection = selection}

set_deck_browser : Struct.Page.Room.DeckBrowser.Type -> Type -> Type
set_deck_browser deck_browser room = {room | deck_browser = deck_browser}

decoder : (Json.Decode.Decoder Struct.Event.Type)
decoder =
   (Json.Decode.map
      ( \room ->
         (Struct.Event.SetRoom room)
      )
      (Json.Decode.field Comm.Protocol.session_token_field Json.Decode.string)
      (Json.Decode.field Comm.Protocol.user_id_field Json.Decode.string)
      (Json.Decode.field Comm.Protocol.room_field Struct.Json.Decode.int)
      (Json.Decode.field Comm.Protocol.pending_rooms_field
         (Json.Decode.array (Struct.Session.PendingRoom.decoder))
      )
   )
