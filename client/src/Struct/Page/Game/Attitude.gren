module Struct.Page.Game.Attitude exposing
   (
      Type,
      new,
      get_x,
      set_x,
      get_y,
      set_y,
      get_z,
      set_z,
      get_rotation,
      set_rotation,
      merge
   )

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------

-- Third Party -----------------------------------------------------------------

-- Project ---------------------------------------------------------------------

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------
type alias Type =
   {
      x : Int,
      y : Int,
      z : Int,
      rotation : Int
   }

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------
sanitize_rotation : Int -> Int
sanitize_rotation i =
   if (i < -360)
   then (sanitize_rotation (i + 360))
   else if (i > 360)
   then (sanitize_rotation (i - 360))
   else i

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
new : Type
new =
   {
      x = 0,
      y = 0,
      z = 0,
      rotation = 0
   }

get_x : Type -> Int
get_x attitude = attitude.x

set_x : Int -> Type -> Type
set_x x attitude = {attitude | x = x}

get_y : Type -> Int
get_y attitude = attitude.y

set_y : Int -> Type -> Type
set_y y attitude = {attitude | y = y}

get_z : Type -> Int
get_z attitude = attitude.x

set_z : Int -> Type -> Type
set_z z attitude = {attitude | z = z}

get_rotation : Type -> Int
get_rotation attitude = attitude.rotation

set_rotation : Int -> Type -> Type
set_rotation rotation attitude =
   {attitude | rotation = (sanitize_rotation rotation)}

merge : Type -> Type -> Type
merge a b =
   {
      x = (a.x + b.x),
      y = (a.y + b.y),
      z = (a.z + b.z),
      rotation = (sanitize_rotation (a.rotation + b.rotation))
   }
