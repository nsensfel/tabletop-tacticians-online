module Struct.Page.CreateRoom.Room exposing
   (
      Type,
      new,
      get_id,
      set_id,
      get_name,
      set_name,
      get_image,
      set_image,
      get_description,
      set_description,
      get_url,
      set_url
   )

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------

-- Third Party -----------------------------------------------------------------

-- Project ---------------------------------------------------------------------

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------
type alias Type =
   {
      id : String,
      name : String,
      image : String,
      description : String,
      url : String
   }

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
new : Type
new =
   {
      id = "",
      name = "",
      image = "",
      description = "",
      url = ""
   }

get_name : Type -> String
get_name room = room.name

set_name : String -> Type -> Type
set_name name room = {room | name = name}

get_id : Type -> String
get_id room = room.id

set_id : String -> Type -> Type
set_id id room = {room | id = id}

get_image : Type -> String
get_image room = room.image

set_image : String -> Type -> Type
set_image image room = {room | image = image}

get_description : Type -> String
get_description room = room.description

set_description : String -> Type -> Type
set_description description room = {room | description = description}

get_url : Type -> String
get_url room = room.url

set_url : String -> Type -> Type
set_url url room = {room | url = url}
