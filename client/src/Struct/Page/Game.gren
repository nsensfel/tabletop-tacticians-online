module Struct.Page.Game exposing
   (
      Type,
      Event(..),
      new,
      get_decks,
      set_decks,
      get_cards,
      set_cards,
      event_to_string
   )

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------

-- Third Party -----------------------------------------------------------------

-- Project ---------------------------------------------------------------------

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------
type alias Type =
   {
      id : String,
      decks : (Dict String Struct.Page.Game.Deck.Type),
      cards : (Dict String Struct.Page.Game.Card.Type)
   }

-- Events here are how the user interact with the client. Not the puppeteer's
-- actions.
type Event =
   SelectCard Int
   | CancelSelection

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
event_to_string : Event -> String
event_to_string event =
   when event is
      (SelectCard _) -> "SelectCard"
      CancelSelection -> "CancelSelection"

new : Type
new =
   {
      id = "",
      decks = (Dict.empty),
      cards = (Dict.empty)
   }

get_decks : Type -> (Dict String Struct.Page.Game.Deck.Type)
get_decks game = game.decks

set_decks : (Dict String Struct.Page.Game.Card.Type) -> Type -> Type
set_decks decks game = {game | decks = decks}

get_cards : Type -> (Dict String Struct.Page.Game.Card.Type)
get_cards game = game.cards

set_cards : (Dict String Struct.Page.Game.Card.Type) -> Type -> Type
set_cards cards game = {game | cards = cards}
