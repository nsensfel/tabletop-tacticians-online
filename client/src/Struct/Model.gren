module Struct.Model exposing
   (
      Type,
      new,
      get_page,
      set_page,
      get_navigation_key,
      get_error_tracker,
      set_error_tracker,
      push_error,
   )

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Browser.Navigation

import Url

-- Third Party -----------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Page
import Struct.Error
import Struct.ErrorTracker

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------
type alias Type =
   {
      page : Struct.Page.Type,
      nav_key : Browser.Navigation.Key,
      error_tracker : Struct.ErrorTracker.Type
   }

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
new : Url.Url -> Browser.Navigation.Key -> Type
new url nav_key =
   {
      page = (Struct.Page.new url),
      nav_key = nav_key
   }

get_page : Type -> Struct.Page.Type
get_page model = model.page

set_page : Struct.Page.Type -> Type -> Type
set_page page model = {model | page = page}

get_navigation_key : Type -> Browser.Navigation.Key
get_navigation_key model = model.nav_key

get_error_tracker : Type -> Struct.ErrorTracker.Type
get_error_tracker model = model.error_tracker

set_error_tracker : Struct.ErrorTracker.Type -> Type -> Type
set_error_tracker error_tracker model = {model | error_tracker = error_tracker}

push_error : Struct.Error.Category -> String -> Type -> Type
push_error category message =
   {model |
      error_tracker =
         (Struct.ErrorTracker.push
            (Struct.Error.new category message)
            model.error_tracker
         )
   }
