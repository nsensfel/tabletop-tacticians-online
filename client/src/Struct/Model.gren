module Struct.Model exposing
   (
      Type,
      new,
      get_page,
      set_page,
      get_navigation_key,
      get_error_tracker,
      set_error_tracker,
      maybe_get_session,
      set_session,
      erase_session,
      maybe_get_confirmation,
      set_confirmation,
      erase_confirmation,
      push_error
   )

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Browser.Navigation

import Url

-- Third Party -----------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Page
import Struct.Error
import Struct.Session
import Struct.Confirmation
import Struct.ErrorTracker

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------
type alias Type =
   {
      confirmation : (Maybe Struct.Confirmation.Type),
      session : (Maybe Struct.Session.Type),
      page : Struct.Page.Type,
      nav_key : Browser.Navigation.Key,
      error_tracker : Struct.ErrorTracker.Type
   }

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
new : Url.Url -> Browser.Navigation.Key -> Type
new url nav_key =
   {
      confirmation = Nothing,
      session = Nothing,
      page = (Struct.Page.new url),
      nav_key = nav_key,
      error_tracker = (Struct.ErrorTracker.new)
   }

maybe_get_session : Type -> (Maybe Struct.Session.Type)
maybe_get_session model = model.session

set_session : Struct.Session.Type -> Type -> Type
set_session session model = {model | session = (Just session)}

erase_session : Type -> Type
erase_session model = {model | session = Nothing}

maybe_get_confirmation : Type -> (Maybe Struct.Confirmation.Type)
maybe_get_confirmation model = model.confirmation

set_confirmation : Struct.Confirmation.Type -> Type -> Type
set_confirmation confirmation model =
   {model | confirmation = (Just confirmation)}

erase_confirmation : Type -> Type
erase_confirmation model = {model | confirmation = Nothing}

get_page : Type -> Struct.Page.Type
get_page model = model.page

set_page : Struct.Page.Type -> Type -> Type
set_page page model = {model | page = page}

get_navigation_key : Type -> Browser.Navigation.Key
get_navigation_key model = model.nav_key

get_error_tracker : Type -> Struct.ErrorTracker.Type
get_error_tracker model = model.error_tracker

set_error_tracker : Struct.ErrorTracker.Type -> Type -> Type
set_error_tracker error_tracker model = {model | error_tracker = error_tracker}

push_error : Struct.Error.Category -> String -> Type -> Type
push_error category message model =
   {model |
      error_tracker =
         (Struct.ErrorTracker.push
            (Struct.Error.new category message)
            model.error_tracker
         )
   }
