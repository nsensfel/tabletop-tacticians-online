module Struct.Page exposing (Type(..), new)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Url

-- Third Party -----------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Page.CreateRoom
import Struct.Page.EditProfile
import Struct.Page.Loading
import Struct.Page.Login
import Struct.Page.Register
import Struct.Page.Room
import Struct.Page.RoomList

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------
type Type =
   Home
   | CreateRoom Struct.Page.CreateRoom.Type
   | EditProfile Struct.Page.EditProfile.Type
   | Loading Struct.Page.Loading.Type
   | Login Struct.Page.Login.Type
   | Register Struct.Page.Register.Type
   | Room Struct.Page.Room.Type
   | RoomList Struct.Page.RoomList.Type
   | Unknown String

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
new : String -> Type
new name =
   when name is
      "" -> Home
      "login" -> (Login (Struct.Page.Login.new))
      "register" -> (Register (Struct.Page.Register.new))
      "edit_profile" -> (Loading (Struct.Page.Loading.new))
      "room_list" -> (RoomList (Struct.Page.RoomList.new))
      "create_room" -> (CreateRoom (Struct.Page.CreateRoom.new))
      "room" -> (Loading (Struct.Page.Loading.new))
      other -> (Unknown other)
