module Module.Update exposing (update)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Event
import Struct.Model

import Update.LoginFormSubmitted
import Update.LoginSetPasswordTo
import Update.LoginSetUsernameTo
import Update.PageURLChangedTo
import Update.PageURLRequested

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
update :
   (
      Struct.Event.Type ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
update event model =
   when event is
      Struct.Event.LoginFormSubmitted ->
         (Update.LoginFormSubmitted.update model)

      (Struct.Event.LoginSetPasswordTo password) ->
         (Update.LoginSetPasswordTo.update password model)

      (Struct.Event.LoginSetUsernameTo username) ->
         (Update.LoginSetUsernameTo.update username model)

      (Struct.Event.PageURLChangedTo url) ->
         (Update.PageURLChangedTo.update url model)

      (Struct.Event.PageURLRequested url_request) ->
         (Update.PageURLRequested.update url_request model)

      _ -> {model = model, command = Cmd.none}
