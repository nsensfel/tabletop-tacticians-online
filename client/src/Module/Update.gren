module Module.Update exposing (update)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Event
import Struct.Model
import Struct.Error

import Update.Dirty
import Update.LoginPage
import Update.EditProfilePage
import Update.RoomListPage
import Update.RoomPage
import Update.RegisterPage
import Update.SetLocalValue
import Update.EraseLocalValue
import Update.SetUrlParam
import Update.EraseUrlParam

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------
handle_sequence :
   (
      (Array Struct.Event.Type) ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, commands : (Array (Cmd Struct.Event.Type)) }
   )
handle_sequence events model =
   (Array.foldl
      (\event current ->
         let
            added = (handle_event event current.model)
         in
            {
               model = added.model,
               commands = (Array.pushLast added.command current.commands)
            }
      )
      {model = model, commands = []}
      events
   )

handle_event :
   (
      Struct.Event.Type ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
handle_event event model =
   when event is
      (Struct.Event.LoginPage login_page_event) ->
         (Update.LoginPage.update login_page_event model)

      (Struct.Event.EditProfilePage edit_profile_page_event) ->
         (Update.EditProfilePage.update edit_profile_page_event model)

      (Struct.Event.RegisterPage register_page_event) ->
         (Update.RegisterPage.update register_page_event model)

      (Struct.Event.RoomListPage room_list_page_event) ->
         (Update.RoomListPage.update room_list_page_event model)

      (Struct.Event.RoomPage room_page_event) ->
         (Update.RoomPage.update room_page_event model)

      (Struct.Event.SetLocalValue key_value) ->
         (Update.SetLocalValue.update key_value model)

      (Struct.Event.EraseLocalValue key) ->
         (Update.EraseLocalValue.update key model)

      (Struct.Event.SetUrlParam key_value) ->
         (Update.SetUrlParam.update key_value model)

      (Struct.Event.EraseUrlParam key) ->
         (Update.EraseUrlParam.update key model)

      (Struct.Event.ErrorOccurred error) ->
         {
            model =
               (Struct.Model.push_error
                  (Struct.Error.get_category error)
                  (Struct.Error.get_message error)
                  model
               ),
            command = Cmd.none
         }

      (Struct.Event.Sequence events) ->
         let
            result = (handle_sequence events model)
         in
            {model = result.model, command = (Cmd.batch result.commands)}

      other ->
         {
            model =
               (Struct.Model.push_error
                  Struct.Error.Programming
                  ("Unhandled event: " ++ (Struct.Event.to_string other))
                  model
               ),
            command = Cmd.none
         }

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
update :
   (
      Struct.Event.Type ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
update event model = (Update.Dirty.handle (handle_event event model))
