module Module.View exposing (view)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Browser

import Html

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Event
import Struct.Model
import Struct.Page

import View.Page.EditProfile
import View.Page.Room
import View.Page.RoomList
import View.Page.Home
import View.Page.Login
import View.Page.Register

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
view : Struct.Model.Type -> (Browser.Document Struct.Event.Type)
view model =
   when model.page is
      Struct.Page.Home -> (View.Page.Home.view model)
      (Struct.Page.Login login) -> (View.Page.Login.view model login)
      (Struct.Page.Register register) ->
         (View.Page.Register.view model register)

      (Struct.Page.Room room) -> (View.Page.Room.view model room)
      (Struct.Page.RoomList room_list) ->
         (View.Page.RoomList.view model room_list)

      (Struct.Page.EditProfile edit_profile) ->
         (View.Page.EditProfile.view model edit_profile)

      _ ->
         {
            title = "Not implemented.",
            body = [ (Html.text "This page is not implemented.") ]
         }
