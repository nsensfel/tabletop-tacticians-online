init :
   (
      Struct.InvocationParameters.Encoded ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
init flags =
   {
      model = (Struct.Model.new (Struct.InvocationParameters.new (Debug.log "flags:"  flags))),
      command = Cmd.none
   }
