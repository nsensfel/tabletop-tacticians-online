module Comm.Receive.SetSession exposing (decoder)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Json.Decode

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Event
import Struct.KeyValue

import Comm.Protocol

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
decoder : (Json.Decode.Decoder Struct.Event.Type)
decoder =
   (Json.Decode.map4
      ( \tkn id ->
         (Struct.Event.Sequence
            [
               (Struct.Event.SetLocalValue
                  (Struct.KeyValue.new "session_id" id)
               ),
               (Struct.Event.SetLocalValue
                  (Struct.KeyValue.new "session_token" tkn)
               )
               (Struct.Event.SetSession
                  (Struct.Session.new
                  )
               )
            ]
         )
      )
      (Json.Decode.field Comm.Protocol.session_token_field Json.Decode.string)
      (Json.Decode.field Comm.Protocol.user_id_field Json.Decode.string)
      (Json.Decode.field Comm.Protocol.user_version_field Json.Decode.int)
      (Json.Decode.field Comm.Protocol.pending_rooms_field
         (Json.Decode.list (Struct.Session.PendingRoom.decoder))
      )
   )
