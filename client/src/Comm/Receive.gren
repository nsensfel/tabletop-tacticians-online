module Comm.Receive exposing (expect)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Http
import Json.Decode
import Result

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Event
import Struct.Error

-- import Comm.Receive.SetSessionToken

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------
decoder_step1 : String -> (Json.Decode.Decoder Struct.Event.Type)
decoder_step1 reply_type =
   when reply_type is
      -- "sst" -> (Comm.Receive.SetSessionToken.decoder)
      other ->
         (Json.Decode.succeed
            (Struct.Event.UnknownMessageTypeReceived other)
         )

decoder_step0 : (Json.Decode.Decoder Struct.Event.Type)
decoder_step0 =
   (Json.Decode.field "msg" Json.Decode.string)
   |> (Json.Decode.andThen (decoder_step1))

decoder: (Json.Decode.Decoder (Array Struct.Event.Type))
decoder = (Json.Decode.array decoder_step0)

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
expect :
      (Result.Result Http.Error a) ->
      (Json.Decode.Decoder (Array Struct.Event.Type)) ->
      (Http.Expect (Array Struct.Event.Type))
   )
expect result =
   (Http.expectJson
      when result is
         (Result.Ok value) -> (decoder)
         (Result.Err error) ->
            (Json.Decode.succeed
               [
                  (Struct.Event.ErrorOccurred
                     (Struct.Error.new
                        Struct.Error.Network
                        (
                           when error is
                              (Http.BadUrl url) -> ("Invalid URL: " ++ url)
                              Http.Timeout -> "Request timed out."
                              Http.NetworkError -> "Network connection error."
                              (Http.BadBody msg) -> ("Invalid reply: " ++ msg)
                              (Http.BadStatus num) ->
                                 ("HTTP Error: " ++ (String.fromInt num))
                        )
                     )
                  )
               ]
            )
   )
