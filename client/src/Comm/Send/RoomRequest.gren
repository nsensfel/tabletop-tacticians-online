module Comm.Send.RoomRequest exposing (send)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Json.Encode

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Event
import Struct.Model

import Struct.Page.Room

import Comm.Send
import Comm.Protocol

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------
encode : Struct.Page.Room.Type Struct.Model.Type -> Json.Encode.Value
encode room model =
   let
      invocation_parameters = (Struct.Model.get_invocation_parameters model)
   in
      (Json.Encode.object
         [ -- The credentials part should be shared...
            {
               key = (Comm.Protocol.user_id_field),
               value = (Json.Encode.string (Struct.Page.Room.get_username room))
            },
            {
               key = (Comm.Protocol.session_token_field),
               value = (Json.Encode.string (Struct.Page.Room.get_password room))
            },
            {
               key = (Comm.Protocol.user_version_field),
               value = (Json.Encode.string (Struct.Page.Room.get_password room))
            }
         ]
      )

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
send :
   (
      Struct.Page.Room.Type ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
send room model =
   {
      model = model,
      command = (Comm.Send.send (encode room model) Comm.Send.RoomHandler)
   }
