module Comm.Send.EditProfileRequest exposing (send)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Json.Encode

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Event
import Struct.Model

import Struct.Page.EditProfile

import Comm.Send

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------
encode : Struct.Page.EditProfile.Type -> Json.Encode.Value
encode edit_profile =
   (Json.Encode.object
      [
         {
            key = "pwd",
            value =
               (Json.Encode.string
                  (Struct.Page.EditProfile.get_password edit_profile)
               )
         },
         {
            key = "dnm",
            value =
               (Json.Encode.string
                  (Struct.Page.EditProfile.get_displayed_name edit_profile)
               )
         },
         {
            key = "eml",
            value =
               (Json.Encode.string
                  (Struct.Page.EditProfile.get_email edit_profile)
               )
         },
         {
            key = "npd",
            value =
               (Json.Encode.string
                  (Struct.Page.EditProfile.get_new_password edit_profile)
               )
         }
      ]
   )

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
send :
   (
      Struct.Page.EditProfile.Type ->
      Struct.Model.Type ->
      { model : Struct.Model.Type, command : (Cmd Struct.Event.Type) }
   )
send edit_profile model =
   {
      model = model,
      command =
         (Comm.Send.send (encode edit_profile) Comm.Send.EditProfileHandler)
   }
