--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
view :
   (
      Struct.Model.Type ->
      Struct.Page.Register.Type ->
      (Browser.Document Struct.Event.Type)
   )
view model register =
   {
      title = "Register",
      body =
      [
         (Html.article
            []
            [
               (username_field register),
               (password_field register),
               (password_confirmation_field register),
               (displayed_name_field register),
               (email_field register),
               (Html.button
                  [
                     (Html.Events.onClick
                        (Struct.Event.RegisterPage
                           Struct.Page.Register.FormSubmitted
                        )
                     )
                  ]
                  [
                     (Html.text "Send")
                  ]
               )
            ]
         )
      ]
   }
