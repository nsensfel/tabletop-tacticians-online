module View.Register exposing (view)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Browser

import Html
import Html.Attributes
import Html.Events

import String

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Model
import Struct.Event

import Struct.Page.Register

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------
username_field : Struct.Page.Register.Type -> (Html.Html Struct.Event.Type)
username_field register =
   let
      username = (Struct.Page.Register.get_username register)
   in
      (Html.div
         [
            (Html.Attributes.class "user-input"),
            (Html.Attributes.class "register-username")
         ]
         [
            (Html.h1 [] [ (Html.text "Username") ]),
            (Html.input
               [
                  (Html.Events.onInput
                     ( \new_username ->
                        (Struct.Event.RegisterPage
                           (Struct.Page.Register.SetUsernameTo new_username)
                        )
                     )
                  ),
                  (Html.Attributes.value username),
                  if (String.isEmpty username)
                  then (Html.Attributes.class "empty-input")
                  else (Html.Attributes.class "")
               ]
               [
               ]
            )
         ]
      )

