module View.Room.Card exposing (get_html)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Html
import Html.Attributes
import Html.Events

import String

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Model
import Struct.Event

import Struct.Page.Room
import Struct.Page.Room.Card
import Struct.Page.Room.Attitude

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------
int_to_px : Int -> String
int_to_px i = ((String.fromInt i) ++ "px")

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
get_html : Struct.Page.Room.Card.Type -> (Html.Html Struct.Event.Type)
get_html card =
   let
      attitude = (Struct.Page.Room.Card.get_attitude card)
   in
      (Html.img
         [
            (Html.Attributes.class "room-card"),
            (Html.Attributes.style
               "width"
               (int_to_px (Struct.Page.Room.Card.get_width card))
            ),
            (Html.Attributes.style
               "height"
               (int_to_px (Struct.Page.Room.Card.get_height card))
            ),
            (Html.Attributes.style
               "top"
               (int_to_px (Struct.Page.Room.Attitude.get_y attitude))
            ),
            (Html.Attributes.style
               "left"
               (int_to_px (Struct.Page.Room.Attitude.get_x attitude))
            ),
            (Html.Attributes.style
               "z-index"
               (String.fromInt (Struct.Page.Room.Attitude.get_z attitude))
            ),
            (Html.Attributes.style
               "transform"
               (
                  "rotate("
                  ++
                  (String.fromInt
                     (Struct.Page.Room.Attitude.get_rotation attitude)
                  )
                  ++ "deg)"
               )
            ),
            (Html.Attributes.hidden
               (not (Struct.Page.Room.Card.get_is_displayed card))
            ),
            (Html.Attributes.src
               (Struct.Page.Room.Card.get_displayed_image card)
            ),
            (Html.Events.onClick
               (Struct.Event.RoomPage
                  (Struct.Page.Room.SelectCard
                     (Struct.Page.Room.Card.get_id card)
                  )
               )
            )
         ]
         [
         ]
      )
