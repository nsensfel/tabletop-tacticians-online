get_html : String -> (Html.Html Struct.Event.Type)
get_html url =
   (Html.img
      [
         (Html.Attributes.class "avatar")
         (Html.Events.on "error" -- And now it's awkward to edit the element... Use JS?
         )
      ]
      [
      ]
   )
