module View.Game.Card exposing (get_html)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Html
import Html.Attributes
import Html.Events

import String

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Model
import Struct.Event

import Struct.Page.Game.Card

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
get_html : Struct.Page.Game.Card.Type -> (Html.Html Struct.Event.Type)
get_html card =
   let
      attitude = (Struct.Page.Game.Card.get_attitude card)
   in
      (Html.img
         [
            (Html.Attributes.class "game-card"),
            (Html.Attributes.style
               "width"
               (Struct.Page.Game.Card.get_width card)
            ),
            (Html.Attributes.style
               "height"
               (Struct.Page.Game.Card.get_height card)
            ),
            (Html.Attributes.style
               "top"
               (
                  (Struct.Page.Game.Attitude.get_y attitude)
                  ++ "px"
               )
            ),
            (Html.Attributes.style
               "left"
               (
                  (Struct.Page.Game.Attitude.get_x attitude)
                  ++ "px"
               )
            ),
            (Html.Attributes.style
               "z-index"
               (Struct.Page.Game.Attitude.get_z attitude)
            ),
            (Html.Attributes.style
               "transform"
               (
                  "rotate("
                  ++ (Struct.Page.Game.Attitude.get_rotation attitude)
                  ++ "deg)"
               )
            ),
            (Html.Attributes.hidden
               !(Struct.Page.Game.Card.get_is_displayed card)
            ),
            (Html.Attributes.src
               (Struct.Page.Game.Card.get_displayed_image card)
            ),
            (Html.Events.onClick (Struct.Page.Game.SelectedCard
(Struct.Page.Game.Card.get_id card)))
         ]
         [
         ]
      )
