module View.Game.Deck exposing (get_html)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Html
import Html.Attributes
import Html.Events

import String

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Model
import Struct.Event

import Struct.Page.Game
import Struct.Page.Game.Deck
import Struct.Page.Game.Attitude

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------
int_to_px : Int -> String
int_to_px i = ((String.fromInt i) ++ "px")

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
get_html : Struct.Page.Game.Deck.Type -> (Html.Html Struct.Event.Type)
get_html deck =
   let
      attitude = (Struct.Page.Game.Deck.get_attitude deck)
   in
      (Html.img
         [
            (Html.Attributes.class "game-deck"),
            (Html.Attributes.style
               "width"
               (int_to_px (Struct.Page.Game.Deck.get_width deck))
            ),
            (Html.Attributes.style
               "height"
               (int_to_px (Struct.Page.Game.Deck.get_height deck))
            ),
            (Html.Attributes.style
               "top"
               (int_to_px (Struct.Page.Game.Attitude.get_y attitude))
            ),
            (Html.Attributes.style
               "left"
               (int_to_px (Struct.Page.Game.Attitude.get_x attitude))
            ),
            (Html.Attributes.style
               "z-index"
               (String.fromInt (Struct.Page.Game.Attitude.get_z attitude))
            ),
            (Html.Attributes.style
               "transform"
               (
                  "rotate("
                  ++
                  (String.fromInt
                     (Struct.Page.Game.Attitude.get_rotation attitude)
                  )
                  ++ "deg)"
               )
            ),
            (Html.Attributes.src
               (Struct.Page.Game.Deck.get_image deck)
            ),
            (Html.Events.onClick
               (Struct.Event.GamePage
                  (Struct.Page.Game.SelectDeck
                     (Struct.Page.Game.Deck.get_id deck)
                  )
               )
            )
         ]
         [
         ]
      )
