module View.Page.Register exposing (view)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Browser

import Html
import Html.Attributes
import Html.Events

import String

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Model
import Struct.Event

import Struct.Page.Register

import Dragoman.RegisterQuery

import View.Avatar
import View.ErrorTracker

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------
username_field : Dragoman.RegisterQuery.Type -> (Html.Html Struct.Event.Type)
username_field query =
   let
      username = (Dragoman.RegisterQuery.get_username query)
   in
      (Html.div
         [
            (Html.Attributes.class "user-input"),
            (Html.Attributes.class "register-username")
         ]
         [
            (Html.h1 [] [ (Html.text "Username") ]),
            (Html.input
               [
                  (Html.Events.onInput
                     ( \new_username ->
                        (Struct.Event.RegisterPage
                           (Struct.Page.Register.SetUsernameTo new_username)
                        )
                     )
                  ),
                  (Html.Attributes.value username),
                  (Html.Attributes.placeholder "username"),
                  if (String.isEmpty username)
                  then (Html.Attributes.class "empty-input")
                  else (Html.Attributes.class "")
               ]
               [
               ]
            )
         ]
      )

avatar_field : Dragoman.RegisterQuery.Type -> (Html.Html Struct.Event.Type)
avatar_field query =
   let
      avatar = (Dragoman.RegisterQuery.get_avatar query)
   in
      (Html.div
         [
            (Html.Attributes.class "user-input"),
            (Html.Attributes.class "register-avatar")
         ]
         [
            (Html.h1 [] [ (Html.text "Avatar") ]),
            (Html.input
               [
                  (Html.Events.onInput
                     ( \new_avatar ->
                        (Struct.Event.RegisterPage
                           (Struct.Page.Register.SetAvatarTo new_avatar)
                        )
                     )
                  ),
                  (Html.Attributes.value avatar),
                  if (String.isEmpty avatar)
                  then (Html.Attributes.class "empty-input")
                  else (Html.Attributes.class "")
               ]
               [
               ]
            ),
            (View.Avatar.get_html avatar)
         ]
      )

password_field : Dragoman.RegisterQuery.Type -> (Html.Html Struct.Event.Type)
password_field query =
   let
      password = (Dragoman.RegisterQuery.get_password query)
   in
      (Html.div
         [
            (Html.Attributes.class "user-input"),
            (Html.Attributes.class "register-password")
         ]
         [
            (Html.h1 [] [ (Html.text "Password") ]),
            (Html.input
               [
                  (Html.Events.onInput
                     ( \new_password ->
                        (Struct.Event.RegisterPage
                           (Struct.Page.Register.SetPasswordTo new_password)
                        )
                     )
                  ),
                  (Html.Attributes.value password),
                  (Html.Attributes.type_ "password"),
                  (Html.Attributes.placeholder "password"),
                  if (String.isEmpty password)
                  then (Html.Attributes.class "empty-input")
                  else (Html.Attributes.class "")
               ]
               [
               ]
            )
         ]
      )

password_confirmation_field:
   (
      Dragoman.RegisterQuery.Type ->
      Struct.Page.Register.Type ->
      (Html.Html Struct.Event.Type)
   )
password_confirmation_field query register =
   let
      password = (Dragoman.RegisterQuery.get_password query)
      password_confirmation =
         (Struct.Page.Register.get_password_confirmation register)
   in
      (Html.div
         [
            (Html.Attributes.class "user-input"),
            (Html.Attributes.class "register-password_confirmation")
         ]
         [
            (Html.h1 [] [ (Html.text "Password Confirmation") ]),
            (Html.input
               [
                  (Html.Events.onInput
                     ( \new_password_confirmation ->
                        (Struct.Event.RegisterPage
                           (Struct.Page.Register.SetPasswordConfirmationTo
                              new_password_confirmation
                           )
                        )
                     )
                  ),
                  (Html.Attributes.value password_confirmation),
                  (Html.Attributes.type_ "password"),
                  (Html.Attributes.placeholder "password"),
                  if (String.isEmpty password_confirmation)
                  then (Html.Attributes.class "empty-input")
                  else (Html.Attributes.class ""),
                  if (password == password_confirmation)
                  then (Html.Attributes.class "validated-input")
                  else (Html.Attributes.class "erroneous-input")
               ]
               [
               ]
            )
         ]
      )

