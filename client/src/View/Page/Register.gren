--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
view :
   (
      Struct.Model.Type ->
      Struct.Page.Register.Type ->
      (Browser.Document Struct.Event.Type)
   )
view model register =
   let query = (Struct.Page.Register.get_query register) in
      {
         title = "Register",
         body =
         [
            (Html.article
               []
               [
                  (username_field query),
                  (password_field query),
                  (password_confirmation_field query register),
                  (displayed_name_field query),
                  (email_field query),
                  (avatar_field query),
                  (Html.button
                     [
                        (Html.Events.onClick
                           (Struct.Event.RegisterPage
                              Struct.Page.Register.FormSubmitted
                           )
                        )
                     ]
                     [
                        (Html.text "Send")
                     ]
                  )
               ]
            ),
            (View.ErrorTracker.get_html model)
         ]
      }
