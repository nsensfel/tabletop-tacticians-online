module View.Page.Room exposing (view)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Browser

import Html
import Html.Attributes
import Html.Events

import String

import Dict

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Model
import Struct.Event

import Struct.Page.Room

import View.ErrorTracker

import View.Page.Room.Card
import View.Page.Room.Deck
import View.Page.Room.Dice
import View.Page.Room.MainMenu

import Dragoman.RoomObject
import Dragoman.RoomObjectAttitude
import Dragoman.RoomObjectProperties

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------
int_to_px : Int -> String
int_to_px i = ((String.fromInt i) ++ "px")

object_get_html_attributes:
   (
      Dragoman.RoomObject.Type ->
      (Array (Html.Attribute Struct.Event.Type))
   )
object_get_html_attributes object =
   let attitude = (Dragoman.RoomObject.get_attitude object) in
      [
         (Html.Events.onClick
            (Struct.Event.RoomPage
               (Struct.Page.Room.SelectObject
                  (Dragoman.RoomObject.get_id object)
               )
            )
         ),
         (Html.Attributes.style
            "width"
            (int_to_px (Dragoman.RoomObject.get_width object))
         ),
         (Html.Attributes.style
            "height"
            (int_to_px (Dragoman.RoomObject.get_height object))
         ),
         (Html.Attributes.style
            "top"
            (int_to_px (Dragoman.RoomObjectAttitude.get_y attitude))
         ),
         (Html.Attributes.style
            "left"
            (int_to_px (Dragoman.RoomObjectAttitude.get_x attitude))
         ),
         (Html.Attributes.style
            "z-index"
            (String.fromInt (Dragoman.RoomObjectAttitude.get_z attitude))
         ),
         (Html.Attributes.style
            "transform"
            (
               "rotate("
               ++
               (String.fromInt
                  (Dragoman.RoomObjectAttitude.get_angle attitude)
               )
               ++ "deg)"
            )
         )
      ]

object_view_html: Dragoman.RoomObject.Type -> (Html.Html Struct.Event.Type)
object_view_html object =
   when (Dragoman.RoomObject.get_properties object) is
      (Dragoman.RoomObjectProperties.Deck deck) ->
         (View.Page.Room.Deck.get_html
            (object_get_html_attributes object)
            deck
         )

      (Dragoman.RoomObjectProperties.Dice dice) ->
         (View.Page.Room.Dice.get_html
            (object_get_html_attributes object)
            dice
         )

      (Dragoman.RoomObjectProperties.Card card) ->
         (View.Page.Room.Card.get_html
            (object_get_html_attributes object)
            card
         )


room_view_html :
   (
      Struct.Model.Type ->
      Struct.Page.Room.Type ->
      (Html.Html Struct.Event.Type)
   )
room_view_html model room =
   (Html.div
      [
         (Html.Attributes.class "room-page")
      ]
      (Array.map
         (object_view_html)
         (Dict.values (Struct.Page.Room.get_objects room))
      )
   )

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
view :
   (
      Struct.Model.Type ->
      Struct.Page.Room.Type ->
      (Browser.Document Struct.Event.Type)
   )
view model room =
   {
      title = "Room",
      body =
         [
            (View.Page.Room.MainMenu.get_html room),
            (room_view_html model room),
            (View.ErrorTracker.get_html model)
         ]
   }
