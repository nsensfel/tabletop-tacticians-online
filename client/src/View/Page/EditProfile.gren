email_field : Dragoman.EditProfileQuery.Type -> (Html.Html Struct.Event.Type)
email_field query =
   let
      email = (Dragoman.EditProfileQuery.get_email query)
   in
      (Html.div
         [
            (Html.Attributes.class "user-input"),
            (Html.Attributes.class "edit-profile-email")
         ]
         [
            (Html.h1 [] [ (Html.text "Email") ]),
            (Html.input
               [
                  (Html.Events.onInput
                     ( \new_email ->
                        (Struct.Event.EditProfilePage
                           (Struct.Page.EditProfile.SetEmailTo new_email)
                        )
                     )
                  ),
                  (Html.Attributes.value email),
                  (Html.Attributes.placeholder "email@domain.com"),
