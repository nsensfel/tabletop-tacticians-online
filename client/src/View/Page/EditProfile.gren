                           (Struct.Page.EditProfile.SetDisplayedNameTo
                              new_displayed_name
                           )
                        )
                     )
                  ),
                  (Html.Attributes.value displayed_name),
                  (Html.Attributes.placeholder "Displayed Name"),
                  if (String.isEmpty displayed_name)
                  then (Html.Attributes.class "empty-input")
