      )

email_field : Struct.Page.EditProfile.Type -> (Html.Html Struct.Event.Type)
email_field edit_profile =
   let
      email = (Struct.Page.EditProfile.get_email edit_profile)
   in
      (Html.div
         [
            (Html.Attributes.class "user-input"),
            (Html.Attributes.class "edit-profile-email")
         ]
         [
            (Html.h1 [] [ (Html.text "Email") ]),
            (Html.input
               [
                  (Html.Events.onInput
                     ( \new_email ->
                        (Struct.Event.EditProfilePage
                           (Struct.Page.EditProfile.SetEmailTo new_email)
                        )
                     )
                  ),
                  (Html.Attributes.value email),
                  (Html.Attributes.placeholder "email@domain.com"),
                  if (String.isEmpty email)
                  then (Html.Attributes.class "empty-input")
                  else (Html.Attributes.class "")
               ]
               [
               ]
            )
         ]
      )

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
view :
   (
      Struct.Model.Type ->
      Struct.Page.EditProfile.Type ->
      (Browser.Document Struct.Event.Type)
   )
view model edit_profile =
   {
      title = "Edit Profile",
      body =
      [
         (Html.article
            []
            [
               (new_password_field edit_profile),
               (new_password_confirmation_field edit_profile),
               (displayed_name_field edit_profile),
               (email_field edit_profile),
               (avatar_field edit_profile),
               (password_field edit_profile),
               (Html.button
                  [
                     (Html.Events.onClick
                        (Struct.Event.EditProfilePage
                           Struct.Page.EditProfile.FormSubmitted
                        )
                     )
                  ]
                  [
                     (Html.text "Send")
                  ]
               )
            ]
         ),
         (View.ErrorTracker.get_html model)
      ]
   }
