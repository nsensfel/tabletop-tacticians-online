               ]
               [
               ]
            )
         ]
      )

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
view :
   (
      Struct.Model.Type ->
      Struct.Page.EditProfile.Type ->
      (Browser.Document Struct.Event.Type)
   )
view model edit_profile =
   let query = (Struct.Page.EditProfile.get_query edit_profile) in
      {
         title = "Edit Profile",
         body =
         [
            (Html.article
               []
               [
                  (new_password_field query),
                  (new_password_confirmation_field query edit_profile),
                  (displayed_name_field query),
                  (email_field query),
                  (avatar_field query),
                  (password_field query),
                  (Html.button
                     [
                        (Html.Events.onClick
                           (Struct.Event.EditProfilePage
                              Struct.Page.EditProfile.FormSubmitted
                           )
                        )
                     ]
                     [
                        (Html.text "Send")
                     ]
                  )
               ]
            ),
            (View.ErrorTracker.get_html model)
         ]
      }
