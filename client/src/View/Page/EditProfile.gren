module View.Page.EditProfile exposing (view)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Browser

import Html
import Html.Attributes
import Html.Events

import String

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Dragoman.EditProfileQuery

import Struct.Model
import Struct.Event

import Struct.Page.EditProfile

import View.Avatar
import View.ErrorTracker

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------
new_password_field :
   (
      Dragoman.EditProfileQuery.Type ->
      (Html.Html Struct.Event.Type)
   )
new_password_field query =
   let
      new_password = (Dragoman.EditProfileQuery.get_new_password query)
   in
      (Html.div
         [
            (Html.Attributes.class "user-input"),
            (Html.Attributes.class "edit-profile-new-password")
         ]
         [
            (Html.h1 [] [ (Html.text "New Password") ]),
            (Html.input
               [
                  (Html.Events.onInput
                     ( \new_new_password ->
                        (Struct.Event.EditProfilePage
                           (Struct.Page.EditProfile.SetNewPasswordTo
                              new_new_password
                           )
                        )
                     )
                  ),
                  (Html.Attributes.value new_password),
                  (Html.Attributes.type_ "password"),
                  (Html.Attributes.placeholder "password"),
                  if (String.isEmpty new_password)
                  then (Html.Attributes.class "empty-input")
                  else (Html.Attributes.class "")
               ]
               [
               ]
            )
         ]
      )

password_field : Dragoman.EditProfileQuery.Type -> (Html.Html Struct.Event.Type)
password_field query =
   let
      password = (Dragoman.EditProfileQuery.get_password query)
   in
      (Html.div
         [
            (Html.Attributes.class "user-input"),
            (Html.Attributes.class "edit-profile-password")
         ]
         [
            (Html.h1 [] [ (Html.text "Password (Required)") ]),
            (Html.input
               [
                  (Html.Events.onInput
                     ( \new_password ->
                        (Struct.Event.EditProfilePage
                           (Struct.Page.EditProfile.SetPasswordTo new_password)
                        )
                     )
                  ),
                  (Html.Attributes.value password),
                  (Html.Attributes.type_ "password"),
                  (Html.Attributes.placeholder "password"),
                  if (String.isEmpty password)
                  then (Html.Attributes.class "empty-input")
                  else (Html.Attributes.class "")
               ]
               [
               ]
            )
         ]
      )

new_password_confirmation_field :
   (
      Dragoman.EditProfileQuery.Type ->
      Struct.Page.EditProfile.Type ->
      (Html.Html Struct.Event.Type)
   )
new_password_confirmation_field query edit_profile =
   let
      new_password = (Dragoman.EditProfileQuery.get_new_password query)
      new_password_confirmation =
         (Struct.Page.EditProfile.get_new_password_confirmation edit_profile)
   in
      (Html.div
         [
            (Html.Attributes.class "user-input"),
            (Html.Attributes.class "edit-profile-new-password-confirmation")
         ]
         [
            (Html.h1 [] [ (Html.text "New Password Confirmation") ]),
            (Html.input
               [
                  (Html.Events.onInput
                     ( \new_value ->
                        (Struct.Event.EditProfilePage
                           (Struct.Page.EditProfile.SetNewPasswordConfirmationTo
                              new_value
                           )
                        )
                     )
                  ),
                  (Html.Attributes.value new_password_confirmation),
                  (Html.Attributes.type_ "password"),
                  (Html.Attributes.placeholder "password"),
                  if (String.isEmpty new_password_confirmation)
                  then (Html.Attributes.class "empty-input")
                  else (Html.Attributes.class ""),
                  if (new_password == new_password_confirmation)
                  then (Html.Attributes.class "validated-input")
                  else (Html.Attributes.class "erroneous-input")
               ]
               [
               ]
            )
         ]
      )

avatar_field : Dragoman.EditProfileQuery.Type -> (Html.Html Struct.Event.Type)
avatar_field query =
   let
      avatar = (Dragoman.EditProfileQuery.get_avatar query)
   in
      (Html.div
         [
            (Html.Attributes.class "user-input"),
            (Html.Attributes.class "edit-profile-avatar")
         ]
         [
            (Html.h1 [] [ (Html.text "Avatar") ]),
            (Html.input
               [
                  (Html.Events.onInput
                     ( \new_avatar ->
                        (Struct.Event.EditProfilePage
                           (Struct.Page.EditProfile.SetAvatarTo new_avatar)
                        )
                     )
                  ),
                  (Html.Attributes.value avatar),
                  if (String.isEmpty avatar)
                  then (Html.Attributes.class "empty-input")
                  else (Html.Attributes.class "")
               ]
               [
               ]
            ),
            (View.Avatar.get_html avatar)
         ]
      )

