module View.Page.Room.Card exposing (get_html)

--------------------------------------------------------------------------------
-- IMPORTS ---------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Standard Library ------------------------------------------------------------
import Html
import Html.Attributes
import Html.Events

import String

-- Third Party------------------------------------------------------------------

-- Project ---------------------------------------------------------------------
import Struct.Model
import Struct.Event

import Struct.Page.Room
import Struct.Page.Room.Attitude

import Dragoman.RoomObjectCard.Type

--------------------------------------------------------------------------------
-- TYPES -----------------------------------------------------------------------
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- LOCAL FUNCTIONS -------------------------------------------------------------
--------------------------------------------------------------------------------
int_to_px : Int -> String
int_to_px i = ((String.fromInt i) ++ "px")

--------------------------------------------------------------------------------
-- EXPORTED FUNCTIONS ----------------------------------------------------------
--------------------------------------------------------------------------------
get_html :
   (
      (Array Html.Attribute) ->
      Dragoman.RoomObjectCard.Type ->
      (Html.Html Struct.Event.Type)
   )
get_html attributes card =
   (Html.img
      (
         attributes
         ++
         [
            (Html.Attributes.class "room-card"),
            (Html.Attributes.hidden
               (not (Dragoman.RoomObjectCard.get_is_displayed card))
            ),
            (Html.Attributes.src
               (
                  if (Dragoman.RoomObjectCard.get_is_flipped card)
                  then (Dragoman.RoomObjectCard.get_back_url card)
                  else (Dragoman.RoomObjectCard.get_front_url card)
               )
            ),
            -- Make the event part of the shared attributes?
            (Html.Events.onClick
               (Struct.Event.RoomPage
                  (Struct.Page.Room.SelectCard
                     (Struct.Page.Room.Card.get_id card)
                  )
               )
            )
         ]
      )
      [
      ]
   )
