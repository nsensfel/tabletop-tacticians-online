(enum RoomObjectTypeID string
	(entry Card crd)
	(entry Dice dic)
	(entry Deck dek)
)

(object RoomObjectAttitude
	(entry x integer)
	(entry y integer)
	(entry z integer)
	(entry angle integer)
)

(object RoomObjectCard
	(entry object_type obt RoomObjectTypeID (const Card))
	(entry front_url string)
	(entry back_url string)
	(entry is_flipped boolean)
	(entry is_displayed boolean)
)

(object RoomObjectDice
	(entry object_type obt RoomObjectTypeID (const Dice))
	(entry faces (array string))
	(entry active_face integer)
)

(object RoomObjectDeck
	(entry object_type obt RoomObjectTypeID (const Deck))
	(entry url string)
	(entry shows_card boolean)
	(entry contents (array string))
)

(polymorph RoomObjectProperties object_type
	(case Card RoomObjectCard)
	(case Dice RoomObjectDice)
	(case Deck RoomObjectDeck)
)

(object RoomObject
	(entry id string)
	(entry is_locked boolean)
	(entry tags (array string))
	(entry width integer)
	(entry height integer)
	(entry attitude RoomObjectAttitude)
	(entry properties RoomObjectProperties)
)
