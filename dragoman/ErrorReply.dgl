(require ServerReplyID)

(enum ErrorCategoryID string
	(entry Error err)
	(entry MissingInput miss)
	(entry NetworkError net)
	(entry ProgrammingError pog)
	(entry Warning wrn)
)

(object ErrorReply
	(entry message_id msg ServerReplyID (const Error))
	(entry category cat ErrorCategoryID)
	(entry message_content cnt string)
)
