(require ServerReplyID)

(enum Error_Category_ID string
	(entry Error err)
	(entry Missing_Input miss)
	(entry Network_Error net)
	(entry Programming_Error pog)
	(entry Warning wrn)
)

(object Error_Reply
	(entry message_id msg Server_Reply_ID (const error))
	(entry category cat Error_Category_ID)
	(entry message_content cnt string)
)
