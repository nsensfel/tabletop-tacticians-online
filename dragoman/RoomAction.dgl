(enum Room_Action_ID string
	(entry Move mov)
)

(object Room_Action_Move
	(entry action_type act Room_Action_ID (const move))
	(entry object_ids oid (array string))
	(entry x_offset xof integer)
	(entry y_offset yof integer)
	(entry z_offset zof integer)
	(entry angle_offset aof integer)
)

(polymorph Room_Action_Details action_type
	(case Move Room_Action_Move)
)

(object Room_Action
	(entry actor_id aid string)
	(entry details det Room_Action_Details)
)
